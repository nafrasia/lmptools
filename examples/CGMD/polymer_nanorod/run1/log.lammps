# ----------------- Settings Section -----------------

include "polymer_melt.in.settings"
group flexChains type 1
32000 atoms in group flexChains
group rigidChains type 2
3840 atoms in group rigidChains
#---- Pair (non bonded interactions) coeffs ----
pair_coeff 1 1 5.0
pair_coeff 1 2 5.0
pair_coeff 2 2 5.0

#---- Bond Coeffs ----
