reset_timestep 0

include "in.equilibrate"
variable weak_damp equal 100
variable strong_damp equal 100
variable sigma equal 1.0
variable eps equal 1.0
variable cutoff_replusive equal "2^(1/6)*v_sigma"
variable cutoff_attractive equal "2.5*v_sigma"

timestep 0.005
neighbor        0.5 bin
neigh_modify    delay 0 every 5 check yes
comm_modify     cutoff 2.5

thermo_style custom step temp press etotal vol density enthalpy
thermo 2000

#-----------------------------------------------
# push atoms apart using the soft potential
#----------------------------------------------
pair_style soft ${cutoff_replusive}
pair_style soft 1.12246204830937
variable prefactor equal ramp(0,100)
fix 1 all adapt 1 pair soft a * * v_prefactor
fix 2 rigidChains rigid molecule
  960 rigid bodies with 3840 atoms
fix 3 flexChains nve
run 200000
