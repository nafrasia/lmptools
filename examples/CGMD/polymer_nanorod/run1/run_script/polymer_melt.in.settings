group flexChains type 1
group rigidChains type 2
#---- Pair (non bonded interactions) coeffs ----
pair_coeff 1 1 5.0
pair_coeff 1 2 5.0
pair_coeff 2 2 5.0

#---- Bond Coeffs ----
bond_coeff 1 34.1594 1.5 1.0 1.0
#---- Angle Coeffs ----
angle_coeff 1 1000.0 180.0

# Straighten up the rigid rods
variable rc equal 5.0
thermo 100
min_style sd
minimize 1e-50 1e-50 50000 100000
reset_timestep 0

include "in.equilibrate"
