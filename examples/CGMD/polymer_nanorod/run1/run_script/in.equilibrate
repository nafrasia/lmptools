variable weak_damp equal 100
variable strong_damp equal 100
variable sigma equal 1.0
variable eps equal 1.0
variable cutoff_replusive equal "2^(1/6)*v_sigma"
variable cutoff_attractive equal "2.5*v_sigma"

timestep 0.005
neighbor        0.5 bin
neigh_modify    delay 0 every 5 check yes
comm_modify     cutoff 2.5

thermo_style custom step temp press etotal vol density enthalpy
thermo 2000

#-----------------------------------------------
# push atoms apart using the soft potential
#----------------------------------------------
pair_style soft ${cutoff_replusive}
variable prefactor equal ramp(0,100)
fix 1 all adapt 1 pair soft a * * v_prefactor
fix 2 rigidChains rigid molecule
fix 3 flexChains nve
run 200000
unfix 1
unfix 2
unfix 3

# Switch to LJ potential
reset_timestep 0
pair_style lj/cut ${cutoff_attractive}
pair_coeff * * 0 1.0
pair_coeff 1 1 1.0 1.0 ${cutoff_replusive}
pair_coeff 2 2 1.0 1.0 ${cutoff_replusive}
pair_coeff 1 2 1.0 1.0 ${cutoff_attractive}
run 0

# Minimize energy with box/relax
min_style sd
fix b0 all box/relax iso 1 vmax 0.001
minimize 1e-50 1e-50 50000 100000
unfix b0
reset_timestep 0

dump 1 rigidChains custom 10000 dump.rigidChains.lammpstrj id type mol x y z ix iy iz
dump_modify 1 sort id
dump 2 flexChains custom 10000 dump.flexChains.lammpstrj id type mol x y z ix iy iz
dump_modify 2 sort id

# Equlibrate
fix 1 flexChains langevin 1.0 1.0 100 1534 zero yes
fix 4 rigidChains rigid molecule langevin 1.0 1.0 100 2129
fix 3 flexChains nve
fix 5 all momentum 20000 linear 1 1 1
run 1000000

fix 2 all press/berendsen iso 0.25 0.25 $(1000*dt*5)
run 1000000
unfix 2

fix 2 all press/berendsen iso 0.5 0.5 $(1000*dt*5)
run 2000000
unfix 2

fix 2 all press/berendsen iso 0.75 0.75 $(1000*dt*5)
run 2000000
unfix 2

fix 2 all press/berendsen iso 1 1 $(1000*dt*5)
run 14000000
